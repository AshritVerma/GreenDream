# Copy to .env and fill in. Never commit .env.

# Enables the Claude tier. Without it the service runs the local fallback only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Master switch for the Claude tier: 0 forces the local fallback even with a key.
GD_USE_LLM=1

# Intake gate: auto (closes at sunset) | open | closed (kill switch).
GD_GATE=auto

# Shared secret the frontend sends as X-Ingest-Token. Empty = no auth (dev only).
GD_INGEST_TOKEN=

# Required for POST /api/admin/switch. Empty = the admin route is disabled.
GD_ADMIN_TOKEN=

# Where the frontend can watch the building when intake is closed.
GD_LIVE_VIEW_URL=https://sundai.willsarg.com/olive-koala?view=street

# Comma-separated origins for CORS, or * for any.
GD_CORS_ORIGINS=*

# Building location (MIT Green Building) and timezone for sun times.
GD_LAT=42.3603
GD_LON=-71.0893
GD_TZ=America/New_York

# Rate limits per client IP.
GD_RATE_SECONDS=20
GD_RATE_PER_HOUR=20

# One query = one thing to show. Caps on how much a person may say.
GD_MAX_WORDS=5
GD_MAX_CHARS=60
